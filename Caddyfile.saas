# Публичный вход Revenue Autopilot (SaaS-пресет). Caddy в host-network:
# все апстримы - loopback хоста, наружу только 80/443 (ufw allow), LE-серт
# автоматом. Хост задаётся env SAAS_HOST (боевой: retivo.digital).

# Старый технический адрес -> постоянный редирект на боевой домен.
ra.187-77-157-6.sslip.io {
	redir https://{$SAAS_HOST}{uri} permanent
}
{$SAAS_HOST} {
	encode gzip

	# Supabase (kong): auth/rest для SPA. Префикс срезается.
	handle_path /supabase/* {
		reverse_proxy 127.0.0.1:54321
	}

	# Board API (только /api/* - HTML-страницы легаси-борда наружу не отдаём).
	handle /api/* {
		reverse_proxy 127.0.0.1:8050
	}

	# Публичные ручки сниппета (in-app inbox): Bearer = ingest-токен тенанта.
	handle /public/* {
		reverse_proxy 127.0.0.1:8050
	}

	# Ingest: сниппеты тенантов постят события сюда.
	handle /ingest/* {
		reverse_proxy 127.0.0.1:8081
	}

	# Stripe-вебхуки тенантов. Без STRIPE_WEBHOOK_SECRET приём fail-closed (400),
	# так что публичный маршрут безопасен до подключения ключей клиента.
	handle /stripe/* {
		reverse_proxy 127.0.0.1:8082
	}

	# Демо-сайт тенанта + сниппет (статика, пути как в репо).
	handle /demo-site/* {
		root * /srv/ra
		file_server
	}
	handle /snippet/* {
		root * /srv/ra
		# Без явного Cache-Control браузер кеширует эвристически (доля от
		# возраста файла): чем старее ra.js, тем дольше сайты клиентов сидят
		# на старой версии. 5 минут = правки доезжают предсказуемо.
		header Cache-Control "public, max-age=300"
		file_server
	}

	# Корень домена - ВСЕГДА продуктовый лендинг (и для залогиненных тоже).
	# Приложение живёт на /home и глубже; вход: /login (после - редирект /home).
	handle / {
		root * /srv/ra/site
		rewrite * /index.html
		file_server
	}

	# Всё остальное - SPA (Next.js standalone на loopback).
	handle {
		reverse_proxy 127.0.0.1:3000
	}
}
