# ─────────────────────────────────────────────────────────────────────────────
# Tegsoft (звонилка) — шаблон конфигурации. Скопируйте нужные строки в основной
# .env сервера и ЗАПОЛНИТЕ значения. Секреты живут ТОЛЬКО на сервере (никогда не в
# NEXT_PUBLIC_* и не во фронте). Файл-пример коммитить можно, реальный .env — нет.
#
# Переключение mock → боевой Tegsoft делается ОДНОЙ строкой (CALL_PROVIDER=tegsoft),
# без правок кода. Пока переменные не заполнены — работает MockProvider (dev/CI).
# ─────────────────────────────────────────────────────────────────────────────

# 1) ВКЛючить боевую телефонию (по умолчанию mock)
CALL_PROVIDER=tegsoft

# 2) Инстанс и сервисная учётка (даёт клиент — Лолита/Виктор)
#    URL их Tegsoft-облака:
TEGSOFT_BASE_URL=https://<server>.tegsoftcloud.com
#    Вариант A: логин/пароль сервисной учётки с правом «Webservice access»
TEGSOFT_USERCODE=
TEGSOFT_PASSWORD=
#    Вариант B: Bearer-токен (если дают токен вместо логина — заполнить только это)
TEGSOFT_TOKEN=
#    CONTEXTID профиля исходящей кампании (для originate с записью):
TEGSOFT_PROFILE_CONTEXTID=

# 3) Приёмник событий Tegsoft ECR (webhook) — секрет ГЕНЕРИРУЕМ МЫ и прописываем
#    его же в настройке ECR Definitions на стороне Tegsoft (заголовок X-Tegsoft-Secret).
#    Сгенерировать: `openssl rand -hex 32`
TEGSOFT_WEBHOOK_SECRET=

# 4) Соответствие «оператор SPA → внутренний номер (extension) в Tegsoft».
#    Проще всего — положить ext в JWT оператора (app_metadata.tegsoft_ext).
#    Либо статической картой здесь (uuid_оператора → ext):
TEGSOFT_EXT_MAP={}
#    Дефолтный ext, если для оператора карта не задана (необязательно):
TEGSOFT_DEFAULT_EXT=

# 5) Запись в crm.calls (Postgres/Supabase) — уже требуется ядром для авторизации,
#    здесь просто напоминание, что store.py пишет сюда:
# SUPABASE_DB_URL=postgresql://...

# ── Тонкая настройка (менять только если боевые доки Tegsoft отличаются) ──────────
# Имя метода originate (по докам подтверждены service=RemotePBX и __STARTREC=true;
# точное имя метода сверить на боевом инстансе — при необходимости переопределить):
# TEGSOFT_ORIGINATE_METHOD=originateWithProfile
# Имя сервиса списка записей (Recordings → Get Related Audio File Names):
# TEGSOFT_RECORDINGS_LIST_SERVICE=getRelatedAudioFileNames
# Сеть/устойчивость:
# TEGSOFT_TIMEOUT=15
# TEGSOFT_RETRIES=2
# TEGSOFT_VERIFY_TLS=true
