# =============================================================================
# .env.example — шаблон переменных окружения (в git ТОЛЬКО пример, .env в .gitignore)
# Скопируй в .env и заполни. Секреты (пароли/токены) НЕ коммитить.
# =============================================================================

# ── Звонилка Tegsoft (agent A4 · tegsoft-adapter) ────────────────────────────
# Провайдер: mock (без внешних вызовов, дефолт) | tegsoft (боевая телефония).
# Переключение — ТОЛЬКО этой строкой, без правок кода.
CALL_PROVIDER=mock

# Инстанс клиента: white-label NGTX AI, боевой узел кластера (ПОДТВЕРЖДЕНО 20.07.26,
# см. tegsoft/TEGSOFT_API_NOTES.md «Подтверждено на боевом инстансе»):
#   https://f81o27.ngtxai.com
TEGSOFT_BASE_URL=
# БОЕВАЯ СХЕМА — ТОКЕН (Bearer, stateless; performLogin не нужен). Токен из ЛК:
# Настройки → Управление пользователями → entegreapi → таблица токенов.
# usercode/password — легаси-фолбэк для других инстансов, здесь НЕ работает для API.
TEGSOFT_USERCODE=
TEGSOFT_PASSWORD=
TEGSOFT_TOKEN=
# CONTEXTID профиля исходящей кампании для originateWithProfile (выдан Лолитой 20.07:
# «campaign code»).
TEGSOFT_PROFILE_CONTEXTID=
# Тонкая настройка HTTP-клиента (необязательно).
TEGSOFT_TIMEOUT=15
TEGSOFT_RETRIES=2
TEGSOFT_VERIFY_TLS=true
# UNVERIFIED: имена сервисов сверить на боевом инстансе (см. tegsoft/adapter.py).
TEGSOFT_ORIGINATE_METHOD=originateWithProfile
TEGSOFT_RECORDINGS_LIST_SERVICE=getRelatedAudioFileNames

# Shared-secret приёмника webhook /api/v1/webhooks/tegsoft (машина-машина, fail-closed).
# Сгенерируй случайную строку: `openssl rand -hex 32`.
TEGSOFT_WEBHOOK_SECRET=

# Маппинг оператор→extension. TODO(client): боевой источник — таблица crm.operator_extensions.
# До неё: JSON {"<operator_uuid>":"<ext>", ...} и/или дефолтный extension.
TEGSOFT_EXT_MAP=
TEGSOFT_DEFAULT_EXT=
# Dev-фолбэк идентичности (ТОЛЬКО пока не подключено ядро api/core.py агента A3).
TEGSOFT_DEV_ROLE=operator
TEGSOFT_DEV_USER_ID=

# ── Postgres (Supabase self-host) — приёмник webhook пишет crm.calls ─────────
# Локальный supabase start обычно: postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_DB_URL=

# ── ClickHouse (аналитика + телефон игрока для звонилки) ─────────────────────
CH_HOST=127.0.0.1
CH_PORT=8123
CH_USER=default
CH_PASSWORD=
CH_DB=retention

# ── Chain-runner (исполнитель цепочек · chains/runner.py · W4-T4) ─────────────
# Рубильник исполнения. FAIL-CLOSED: пока НЕ '1'/'true', runner ничего не шлёт и
# не продвигает enrollments (тот же флаг гейтит rt-trigger/pusher). Читается горячо
# из этого .env каждый тик — включение/выключение без рестарта сервиса.
PREDICTIONS_ENABLED=0
# Сухой прогон каналов (общий с pusher): 1 — payload печатается, в сеть/казино
# НИЧЕГО не уходит (согласование формата без боевого токена). 0 — боевые отправки.
SIGNALS_DRY_RUN=1
# Колбэк казино для команд send_message/bonus_grant (Bearer-токен). Пусто → в
# боевом режиме отправки на казино-вебхук вернут 'callback_not_configured'.
CALLBACK_URL=
CALLBACK_TOKEN=
# Период опроса и размер батча продвижения enrollments.
CHAINS_POLL_MS=5000
CHAINS_ADVANCE_BATCH=2000
# Доля контрольной группы по умолчанию, % (если в definition цепочки нет control_pct).
CHAINS_DEFAULT_CONTROL_PCT=16
# Анти-усталость: не больше N реальных касаний за окно (дней) на игрока (send_log).
FATIGUE_MAX_SENDS=3
FATIGUE_WINDOW_DAYS=7
# Канал email (send_message channel=email). Пусто → (False,'smtp_not_configured').
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Канал telegram (send_message channel=telegram) — chat_id берётся из users.telegram_id.
# Пусто → (False,'no_tg_token'). Общий токен с tg-bot допустим.
TELEGRAM_BOT_TOKEN=

# Согласия в цепочках: 'info' (дефолт, решение владельца 18.07 — пустой opt-in от казино
# НЕ режет отправку, пишется пометкой consent_unknown в send_log) | 'enforce' (fail-closed).
# ⚠️ ПРОД-ЧЕКЛИСТ: включить enforce, как только казино начнёт слать opt_in_changed.
CHAINS_CONSENT_MODE=info

# ── Вокабуляр казино (api/casino_vocab.py) — типы/статусы транзакций ─────────────
# Дефолты = BillionBahis. На ДРУГОМ казино (напр. VivaJack у Лолиты) статусы/типы
# отличаются → без переопределения весь борд и конструктор отчётов вернут 0.
# Формат — список через запятую. Оставьте пустым/уберите строку → дефолт.
# Как узнать значения тенанта:
#   SELECT type,status,count() FROM money_transactions GROUP BY type,status;
#   SELECT transaction_type,status,count() FROM game_transactions GROUP BY 1,2;
#CASINO_SUCCESS_STATUSES=completed,approved,success      # успех money-операции
#CASINO_GAME_SUCCESS_STATUSES=completed                  # успех game-операции (ставка/выигрыш)
#CASINO_DEPOSIT_TYPES=deposit                            # типы кэш-депозита
#CASINO_WITHDRAWAL_TYPES=withdrawal                      # типы кэш-вывода (out try = любой статус)
#CASINO_BONUS_TYPES=bonus,manual_bonus,freespin          # типы начисления бонуса
#CASINO_BONUS_WAGED_TYPES=bonus_conversion               # отыгрыш/релиз бонуса на реал
#CASINO_BET_TYPES=bet,freespins_bet                      # типы ставок
#CASINO_WIN_TYPES=win,freespins_win                      # типы выигрышей

# Всегда скрывать игроков этих аффилиатов из списка «Игроки» (коды через запятую), напр.: 104,207
PLAYERS_EXCLUDE_AFFILIATES=

# ── HubContent read-only export (tools/hubcontent_export.py) ────────────────────
# Статический ключ, выданный со стороны hubcontent.ai. Эндпоинт только GET,
# только SELECT'ы, e-mail'ы и контент не отдаются (связка по stripe_customer_id).
HUBCONTENT_API_KEY=
HUBCONTENT_EXPORT_URL=https://hubcontent.ai/api/retivo-export

# ── Microsoft Clarity Data Export (tools/clarity_export.py) ─────────────────────
# Токен выпускает АДМИН проекта Clarity: Settings → Data Export → Generate new API token.
# Жёсткие лимиты: 10 запросов/сутки на проект, только последние 1-3 дня, 1000 строк без
# пагинации, максимум 3 измерения на запрос. Инструмент кэширует сырые ответы на диск.
CLARITY_API_TOKEN=
